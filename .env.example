# Porta do painel (API + interface em produção)
PORT=3333

# Chave da IA (também pode ser configurada pela interface, em Ajustes > IA)
OPENAI_API_KEY=
# Compatível com OpenAI, OpenRouter, Groq, Ollama, etc.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Sincronizar o histórico completo de conversas ao conectar (true/false)
SYNC_FULL_HISTORY=true
